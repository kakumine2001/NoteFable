// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum NoteProposalKind {
  EDIT
  CREATE
}

enum NoteProposalStatus {
  PENDING
  APPLIED
  DISCARDED
}

// ノートの履歴を残した理由。AUTO は編集の合間に一定間隔で残す自動保存、AI_EDIT は AI の編集案を適用する直前、RESTORE は履歴から戻す直前。
enum NoteRevisionReason {
  AUTO
  AI_EDIT
  RESTORE
}

// ワークスペースのページの種類。note は BlockNote の本文（NotePage.blocks）、whiteboard と slides は本体を NoteCanvas に別に置く。
// 作った後は変えない。API の JSON でもこの小文字の値をそのまま使う（src/lib/page-kinds.ts）。
enum PageKind {
  note
  whiteboard
  slides
}

// 利用プラン。PRO は月額の有料プラン（Stripe の購読が有効な間。手動で設定することもできる）。上限は src/lib/usage-plans.ts にある。
enum UserPlan {
  FREE
  PRO
}

enum ReasoningEffort {
  NONE
  LOW
  MEDIUM
  HIGH
  XHIGH
  MAX
}

model User {
  id                 String   @id @default(cuid())
  deviceId           String   @unique
  // Google ログインと紐付けた場合だけ設定する。別端末でも同じ利用者として復元できる。
  googleSub          String?  @unique
  // 確認済みのメールアドレス（小文字）。メールの確認コードでログインした、または Google が確認済みとしたメール。
  // 同じアドレスなら Google でもメールでも同じ利用者になる。null は未ログイン（または未確認のメールだけの Google 利用者）。
  verifiedEmail      String?  @unique
  email              String?
  name               String?
  image              String?
  // Google のプロフィールとは別に、利用者が自分で決めた表示名と絵文字アイコン。null は Google の名前・写真を使う。
  displayName        String?
  avatarIcon         String?
  // 自分でアップロードした写真の保存先（ストレージ内のパス）。null は写真なし。アイコン（絵文字）とはどちらか一方だけ設定する。
  avatarImage        String?
  // すべてのチャットに渡す、利用者自身の指示（カスタム指示）。null は指示なし。ログインした利用者だけが設定でき、匿名の行では使わない。
  customInstructions String?
  // 設定の「アイコン」（AI キャラクターかアップロード画像、src/lib/app-icon.ts）をアカウントで端末間に同期する。ログインした利用者だけが使い、匿名の行では使わない。
  // appIcon は null（既定の Quill）、"character:<id>"、または "image"（appIconImage の画像）。appIconImage はストレージ内のパス
  // （app-icons/<利用者 ID>/<UUID>.<拡張子>、画像の本体は Postgres に置かない）。appIconUpdatedAt が null なら一度も同期していない。
  appIcon            String?
  appIconImage       String?
  appIconUpdatedAt   DateTime?
  // ログインした利用者が設定画面で選んだ表示言語（en / zh / zh-Hant / ja）。null は選んでいない（環境の言語に従う）。匿名の行では使わない。
  locale             String?
  plan               UserPlan @default(FREE)
  // いまの購読をどこで買ったか（stripe = ウェブ、google = Android の Google Play）。下の状態と期間はこの購読のもの。
  subscriptionProvider          String?
  // Stripe の顧客と購読（src/lib/billing.ts）。購読の状態は Webhook と決済後の確認で Stripe から写す。
  stripeCustomerId              String?   @unique
  stripeSubscriptionId          String?   @unique
  // Google Play の購読の購入トークン（src/lib/google-play-billing.ts）。状態はアプリからの報告と RTDN で Google から写す。
  googlePurchaseToken           String?   @unique
  // Stripe の購読の状態（active / past_due / canceled など）。null は購読したことがない。
  subscriptionStatus            String?
  // いまの請求期間。PRO の月の上限はこの期間ごとに数える。
  subscriptionPeriodStart       DateTime?
  subscriptionPeriodEnd         DateTime?
  // 解約の予約日時（その日までは PRO のまま）。null は予約なし。
  subscriptionCancelAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions      Session[]
  chatProjects  ChatProject[]
  notePages     NotePage[]
  storedFiles   StoredFile[]
  noteProposals NoteProposal[]
  noteGroups    NoteGroup[]
  noteRevisions NoteRevision[]
  noteEmbeddings NoteEmbedding[]
}

// メールでのログイン用の確認コード。コードそのものは保存せず、HMAC だけを持つ。使ったら消す。
model EmailLoginCode {
  id            String   @id @default(cuid())
  email         String
  codeHash      String
  expiresAt     DateTime
  attempts      Int      @default(0)
  // 送信元（IP）の HMAC。同じ送信元からの大量送信を数えるためだけに使う。
  requesterHash String?
  createdAt     DateTime @default(now())

  @@index([email, createdAt])
  @@index([requesterHash, createdAt])
}

// アプリ内のページ。ブロックの順序と装飾は編集器の JSON に保持する。
model NotePage {
  id            String    @id @default(cuid())
  userId        String
  title         String    @default("Untitled")
  position      Int       @default(0)
  // ページの種類（ノート・ホワイトボード・スライド）。作った後は変えない。ノート以外は blocks が空配列で、本体は canvas にある。
  kind          PageKind  @default(note)
  // ページ見出しの絵文字アイコンとプリセットのカバー。未設定は null。
  icon          String?
  cover         String?
  // アップロード画像カバーの縦位置（0〜100%）。プリセットでは使わない。
  coverPosition Int?
  blocks        Json
  version       Int       @default(0)
  // 所属グループ。未設定は「グループなし」。グループを消してもノートは残る。
  groupId       String?
  // ゴミ箱に入れた時刻。null は通常のノート。30 日たつと復元できず、完全に削除される。
  deletedAt     DateTime?
  // 親ページ（Notion のサブページ）。null は最上位。子の groupId は最上位の祖先と同じにそろえる。
  parentId      String?
  // お気に入りに入れた時刻。null はお気に入りではない。サイドバーの Favorites はこの順。
  favoritedAt   DateTime?
  // ページの表示設定（Notion の「…」メニュー）。本文の版とは別に保存する。
  fullWidth     Boolean   @default(false)
  smallText     Boolean   @default(false)
  // "default" / "serif" / "mono"
  font          String    @default("default")
  // ロック中は画面での編集を止める（権限ではなく、うっかり編集の防止）。
  locked                 Boolean   @default(false)
  // 公開共有（Notion の Share → Publish）。token は初回公開時に発行し、非公開後も保持する。
  shareToken             String?   @unique
  shareEnabled           Boolean   @default(false)
  shareIncludeSubpages   Boolean   @default(true)
  shareExpiresAt         DateTime?
  // 親ページが公開中でも、このサブページ（とその配下）を公開対象から外す。
  shareExcludeFromParent Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group    NoteGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  parent   NotePage?  @relation("NotePageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children NotePage[] @relation("NotePageTree")

  assistantSessions Session[]
  revisions         NoteRevision[]
  projectRefs       ChatProjectNote[]
  messageRefs       MessageNote[]
  embeddings        NoteEmbedding[]
  canvas            NoteCanvas?

  @@index([userId, updatedAt])
  @@index([userId, groupId])
  @@index([userId, deletedAt])
  @@index([parentId])
}

// ノートの過去の保存状態。復元の元になる。タイトル・アイコン・本文だけを残し、カバーは現在のものを使う。
model NoteRevision {
  id        String             @id @default(cuid())
  noteId    String
  userId    String
  reason    NoteRevisionReason
  // 履歴に残した状態（変更される直前の内容）と、そのときの NotePage.version。
  title     String
  icon      String?
  blocks    Json
  // ホワイトボード・スライドの本体（NoteCanvas.data の写し）。ノートの履歴は null（本文は blocks）。
  data      Json?
  version   Int
  createdAt DateTime           @default(now())

  note NotePage @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@index([userId])
}

// ホワイトボード・スライドの本体。ノートの本文（NotePage.blocks）とは別の表に置き、一覧・検索・ページの読み込みで大きな本体を運ばない。
// 検索・意味検索・チャットの文脈は data から取り出した文字（segments: [{ id, text }]）だけを使い、本体（線の点など）は走査しない。
// 版（競合の判定）は NotePage.version を使う。ページを完全に削除するとカスケードで消える。
model NoteCanvas {
  noteId    String   @id
  data      Json
  // data から取り出した文字。id はホワイトボードの要素、またはスライドのページ（検索結果からそこへ移動する）。
  segments  Json
  // data の JSON の SHA-256（16 進）。応答だけ失われた保存の再送を、本体を読み直さずに見分ける。
  hash      String
  // data の JSON のバイト数（上限の確認と調査用）。
  size      Int
  updatedAt DateTime @updatedAt

  note NotePage @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

// ノート本文の意味検索（セマンティック検索）用のチャンク単位ベクトル。
// NotePage の本文が変わると非同期または検索時の遅延更新で作り直す。
// NotePage を完全削除するとカスケード削除される。ゴミ箱のノートは検索時に NotePage.deletedAt IS NULL で除外する。
model NoteEmbedding {
  id          String   @id @default(cuid())
  noteId      String
  userId      String
  chunkIndex  Int
  // このチャンクの先頭ブロック ID（検索結果から該当箇所へジャンプするために使う。タイトルのみのときは null）。
  blockId     String?
  // 埋め込みを作った時点の NotePage.version。検索時は現在の version と一致する行だけを使い、古い版の本文を出さない。
  noteVersion Int
  // 埋め込みを作った時点のタイトル＋本文の SHA-256（先頭 32 hex 文字）。本文が変わっていなければ再計算しない。
  contentHash String
  // 生成に使ったモデルと次元（モデルを切り替えても古いベクトルと混ぜない）。
  model       String
  dimensions  Int
  // L2 正規化済みの Float32Array（リトルエンディアン、dimensions * 4 バイト）。
  vector      Bytes
  updatedAt   DateTime @updatedAt

  note NotePage @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, chunkIndex])
  @@index([userId, model, dimensions])
  @@index([noteId])
}

// ノートをまとめるグループ（フォルダ）。1 階層だけで、並びは position の昇順。
model NoteGroup {
  id        String   @id @default(cuid())
  userId    String
  name      String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages NotePage[]

  @@index([userId, position])
}

model Session {
  id          String   @id @default(cuid())
  title       String   @default("New chat")
  position    Int      @default(0)
  // 単一の絵文字。null は既定のチャットアイコン。
  icon        String?
  pinned      Boolean  @default(false)
  titleManual Boolean  @default(false)
  projectId   String?
  userId      String
  // ノートの AI パネルで始めた会話は、そのノートに結びつける（パネルの履歴に出す）。Chats の一覧にも出る普通の会話で、ノートを完全に消しても会話は残る。
  noteId      String?
  // 利用者が「停止」を押した時刻。生成中の応答はこの値が変わったのを見て止まり、そこまでの回答を保存する
  // （接続の切断はサーバーに伝わるとは限らないので、明示の要求で止める）。
  stopRequestedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       ChatProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  note          NotePage?      @relation(fields: [noteId], references: [id], onDelete: SetNull)
  messages      Message[]
  noteProposals NoteProposal[]

  @@index([userId, updatedAt])
  @@index([noteId])
  @@index([userId, projectId])
}

model ChatProject {
  id           String            @id @default(cuid())
  userId       String
  name         String
  // プロジェクト内のすべての会話に渡す共通の指示（目的・回答の言語や形式など）。null は指示なし。
  instructions String?
  createdAt    DateTime          @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     Session[]
  notes        ChatProjectNote[]

  @@index([userId, createdAt])
}

// プロジェクトが参照するノート。会話ごとに、ここで選んだノートの内容をモデルに渡す。ノートを完全に削除するとこの行も消える。
model ChatProjectNote {
  projectId String
  noteId    String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  project ChatProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  note    NotePage    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([projectId, noteId])
  @@index([noteId])
}

model Message {
  id              String           @id @default(cuid())
  sessionId       String
  role            MessageRole
  content         String
  model           String?
  reasoningEffort ReasoningEffort?
  // Native provider compaction checkpoint; excluded from browser message queries.
  providerContext String?
  // 回答前の推論要約・検索・ツールの途中経過（ActivityStep[] の JSON）と、本文が届くまでの時間。表示専用でモデルには渡さない。
  activity        String?
  thinkingMs      Int?
  // 会話の枝分かれ（発言の編集・回答の再生成）。parentId は直前の発言の ID、"root" は会話の先頭。
  // null はこの列より前に作られた行で、作成順で直前の発言が親になる。
  parentId        String?
  // 版の切り替えでこの版を選んだ時刻。上の版へ切り替え直したとき、その下では最後に選んでいた版（無ければいちばん新しい版）を表示する。
  selectedAt      DateTime?
  // 表示中の枝にあるか。編集・再生成で置き換えられた版は false にして残し、版の切り替えで戻せる。
  // 会話の内容を読む処理（履歴・検索・書き出し・ツール）は active の行だけを使う。
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())

  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  // 利用者がこの発言に添付した自分のノート（ID だけ。本文は送信のたびにノートから読み直す）。
  notes       MessageNote[]

  @@index([sessionId, createdAt])
}

// チャットの発言に添付したノート。ノートの本文はコピーしない。ノートが完全に削除されると一緒に消える。
model MessageNote {
  messageId String
  noteId    String
  position  Int    @default(0)

  message Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  note    NotePage @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@id([messageId, noteId])
  @@index([noteId])
}

model Attachment {
  id               String   @id @default(cuid())
  messageId        String
  filename         String
  mimeType         String
  size             Int
  extractedText    String?
  imageStoragePath String?
  createdAt        DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  // ファイルの後片付けが、画像がまだどの添付から使われているかを引く。
  @@index([imageStoragePath])
}

// ファイル置き場（Private Vercel Blob、ローカル開発は NOTEFABLE_STORAGE_DIR）に置いたファイルの種類。
// 種類ごとに、どこから参照されているかの調べ方が違う（src/lib/stored-files.ts の参照の確認）。
enum StoredFileKind {
  // note-files/<利用者 ID>/: ノートの画像ブロック・ファイルブロック
  NOTE_FILE
  // page-covers/<利用者 ID>/: ページのカバーとページアイコンの画像
  NOTE_COVER
  // images/YYYY/MM/DD/: チャットの添付画像と生成した画像（Attachment.imageStoragePath）
  CHAT_IMAGE
  // avatars/<利用者 ID>/: プロフィールの写真（User.avatarImage）
  AVATAR
  // app-icons/<利用者 ID>/: 設定の「アイコン」の画像（User.appIconImage）
  APP_ICON
}

// ファイル置き場のファイル 1 つ。容量の上限はこの行の size を利用者ごとに足して数え、どこからも参照されなくなった
// ファイルは猶予のあとで消す（src/lib/stored-files.ts）。行を先に作ってからファイルを書くので、記録のないファイルは残らない。
// releasedAt は参照がない（と確かめた）時刻で、null は使用中。アップロード直後はまだ参照がないので作成時刻を入れる。
model StoredFile {
  path       String         @id
  // 持ち主。アカウントを消すと null になり、ファイルを消し終えたら行も消える（消し損ねても後片付けがやり直す）。
  userId     String?
  kind       StoredFileKind
  // バイト数。null はこの表より前からあるファイルで、ファイル置き場の一覧から大きさを補うまで 0 として数える。
  size       Int?
  releasedAt DateTime?
  // 削除を始めた時刻。ここから先は参照を付けられず、ファイルを消し終えたら行を消す。
  deletingAt DateTime?
  // 後片付けが最後に参照を確かめた時刻。古いものから順に確かめて、件数が多くても全件を巡回する。
  checkedAt  DateTime?
  createdAt  DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([releasedAt])
  @@index([checkedAt])
}

// 定期的な後片付け（ファイルの回収など）の実行状態。cron の代わりに、ふつうのリクエストの後で少しずつ進める。
model MaintenanceJob {
  name        String    @id
  // 次に実行してよい時刻（前回から間をあける）。
  runAfter    DateTime  @default(now())
  // 実行中の印。この時刻までは他のリクエストが同じ仕事を始めない（途中で落ちても、過ぎれば次が引き継ぐ）。
  lockedUntil DateTime?
  // 続きから再開するための状態（ファイル置き場の一覧のどこまで見たかなど）。
  state       Json?
  updatedAt   DateTime  @updatedAt
}

// AI が出したノートの編集・新規作成の提案。ユーザーが適用するまでノートは変わらない。
// 提案はチャットの履歴に残り、再読み込みしても適用・破棄できる。
model NoteProposal {
  id            String             @id @default(cuid())
  userId        String
  sessionId     String
  // 提案を出した回答。回答の保存後に紐付ける（保存前の提案は null）。
  messageId     String?
  kind          NoteProposalKind
  status        NoteProposalStatus @default(PENDING)
  // 画面に出す内容。編集は対象ノートと基準版・差分・適用後のタイトルとブロック、新規は適用するタイトル・アイコン・ブロック。
  payload       Json
  // 新規作成を適用した後のノート ID。再送されても同じノートを返すために使う。
  appliedPageId String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([messageId])
}

// 日ごとの利用回数。key は "user:<利用者 ID>"、または未ログイン利用者のネットワーク単位の "ip:<HMAC>"。
// 利用者行への外部キーは持たない（IP 単位の行もあるため）。古い行は usage-limits.ts が時々消す。
model UsageCounter {
  key       String
  // "chat" / "image"（日ごと）、"chat:month" / "image:month"（月ごと。day は期間の初日）、"report"
  kind      String
  day       DateTime @db.Date
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([key, kind, day])
  @@index([day])
}

// 削除したアカウントの印（deleted-accounts.ts）。key はログイン ID（Google のアカウント ID か確認済みメール）の HMAC で、
// ID そのものは持たない。削除より前に発行されたログイン Cookie が、同じ ID の空のアカウントを作り直さないように使う。
// 400 日たった行は次のアカウント削除のときに消す。
model DeletedAccount {
  key       String   @id
  deletedAt DateTime

  @@index([deletedAt])
}
