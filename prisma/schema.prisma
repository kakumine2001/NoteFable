// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Notion 保存処理の進行状況。下書き作成からページ作成完了まで段階的に進む。
enum NotionSaveStatus {
  STAGING
  TRANSFERRING
  COMPLETED
  CANCELLED
  EXPIRED
}

// 1 ファイルごとの転送状況。失敗しても下書きを残し、同じ行から再試行する。
enum NotionFileStatus {
  PENDING
  STAGED
  UPLOADING
  COMPLETE
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ReasoningEffort {
  NONE
  LOW
  MEDIUM
  HIGH
  XHIGH
  MAX
}

model AnonymousUser {
  id        String   @id @default(cuid())
  deviceId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions    Session[]
  notionSaves NotionSave[]
  notePages   NotePage[]
}

// アプリ内のページ。ブロックの順序と装飾は編集器の JSON に保持する。
model NotePage {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled")
  // ページ見出しの絵文字アイコンとプリセットのカバー。未設定は null。
  icon      String?
  cover     String?
  blocks    Json
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user AnonymousUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Session {
  id        String   @id @default(cuid())
  title     String   @default("New chat")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        AnonymousUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  notionSaves NotionSave[]

  @@index([userId, updatedAt])
}

model Message {
  id              String           @id @default(cuid())
  sessionId       String
  role            MessageRole
  content         String
  model           String?
  reasoningEffort ReasoningEffort?
  createdAt       DateTime         @default(now())

  session     Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments Attachment[]

  @@index([sessionId, createdAt])
}

model Attachment {
  id               String   @id @default(cuid())
  messageId        String
  filename         String
  mimeType         String
  size             Int
  extractedText    String?
  imageStoragePath String?
  createdAt        DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ApiRateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

// Notion 保存 1 回分の処理。本文の並びは blocks に順序付きで保持する。
// 会話の添付（Attachment）とは別に管理し、保存用の一時データだけを持つ。
model NotionSave {
  id        String           @id @default(cuid())
  userId    String
  sessionId String?
  title     String
  status    NotionSaveStatus @default(STAGING)
  // 本文ブロックの配列。text は文字列、file は NotionSaveFile.id を参照する。
  blocks    Json

  notionPageId        String?
  notionPageUrl       String?
  notionBlocksWritten Int     @default(0)
  // ページ作成の結果が不明なまま終わった場合に立てる。無条件の再作成を防ぐ。
  pageCreationUnknown Boolean @default(false)
  // 本文追加の結果が不明な場合、確認なしの再送で重複させない。
  appendResultUnknown Boolean @default(false)
  errorMessage        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    AnonymousUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  files   NotionSaveFile[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}

model NotionSaveFile {
  id        String @id @default(cuid())
  saveId    String
  filename  String
  mimeType  String
  // 5 GiB を扱うため Int ではなく BigInt にする。
  size      BigInt
  // Notion 側で画像ブロックかファイルブロックかを決める。
  blockType String

  status             NotionFileStatus @default(PENDING)
  // 一時保管先（Private Blob のパス接頭辞）と、そこに置いたチャンク数。
  stagingPrefix      String?
  stagingChunkCount  Int              @default(0)
  // Notion の分割転送の進捗。
  partCount          Int              @default(0)
  uploadedParts      Int              @default(0)
  notionFileUploadId String?
  errorMessage       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  save NotionSave @relation(fields: [saveId], references: [id], onDelete: Cascade)

  @@index([saveId])
}
