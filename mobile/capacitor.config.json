{
  "appId": "com.kakumine.studymate",
  "appName": "StudyMate",
  "webDir": "www",
  "server": {
    "url": "https://studymate-lab-ai.vercel.app",
    "androidScheme": "https",
    "cleartext": false,
    "errorPath": "offline.html",
    "allowNavigation": [
      "studymate-lab-ai.vercel.app"
    ]
  },
  "android": {
    "backgroundColor": "#ffffff",
    "allowMixedContent": false
  },
  "plugins": {
    "SocialLogin": {
      "providers": {
        "google": true,
        "facebook": false,
        "apple": false,
        "twitter": false
      }
    }
  }
}
