<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 生成图片存进相册：Android 10 起 MediaStore 不需要权限，只有 8–9 要。 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 「添加文件或照片」里列出本机的相机 App（Android 11 起要声明才能查到）。 -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <!-- 介绍页等要用浏览器打开的链接：找出能打开普通网址的浏览器（AccountUi.kt 的 openInBrowser）。 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".NoteFableApp"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.NoteFable">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|locale|layoutDirection|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 工作区主机（BASE_URL，正式为 app.notefable.com）的链接：/?chat=…&amp;message=…、/app?chat=…。
                 autoVerify="true"：Android 用 https://app.notefable.com/.well-known/assetlinks.json（public/.well-known/）验证后，
                 系统直接用 App 打开，不再询问。整个主机都是工作区，所以只拦这个主机；介绍页、法律页面和登录在 notefable.com，不受影响。 -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${notefableScheme}" />
                <data android:host="${notefableHost}" />
                <data android:path="/" />
                <data android:path="/app" />
                <data android:pathPattern="/.*/app" />
            </intent-filter>
            <!-- 旧主机的聊天链接（以前保存的 notefable.com/?chat=… 等）。不做验证（介绍页也在这个主机，不能抢）：
                 用户在系统的"打开支持的链接"里把它加给 App 后才进 App，否则由浏览器打开并转到工作区主机。 -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="notefable.com" />
                <data android:host="www.notefable.com" />
                <data android:path="/" />
                <data android:path="/app" />
                <data android:pathPattern="/.*/app" />
            </intent-filter>
        </activity>
        <!-- Android 12 及以下：由 AppCompat 保存应用内选择的语言（Android 13+ 由系统保存）。 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- 相机照片和粘贴图片的缓存副本（res/xml/file_paths.xml）。 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
