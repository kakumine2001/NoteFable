# 本番の基本必須
DATABASE_URL="postgresql://user:password@host:5432/neondb?schema=studymate"
COOKIE_SECRET="replace-with-a-long-random-secret"

# OpenAI 機能を使う場合は API キーが必須。URL とモデル名は任意
OPENAI_API_KEY="replace-with-your-openai-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_TEXT_MODEL="gpt-5.5"
OPENAI_IMAGE_MODEL="gpt-image-2"

# DeepSeek 機能を使う場合は API キーが必須。URL とモデル名は任意
DEEPSEEK_API_KEY="replace-with-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
DEEPSEEK_FLASH_MODEL="deepseek-v4-flash"
DEEPSEEK_PRO_MODEL="deepseek-v4-pro"

# DeepSeek で Web 検索を使う場合だけ必須
TAVILY_API_KEY="replace-with-your-tavily-api-key"

# Notion エクスポートを使う場合は両方必須
NOTION_API_KEY="secret_..."
NOTION_DATABASE_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 任意。未設定時は data/storage を使う
STUDYMATE_STORAGE_DIR="data/storage"
